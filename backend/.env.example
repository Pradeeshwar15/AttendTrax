# ── Environment variables required by AttendTrax backend ──────────────────────
# Copy this file as .env and fill in your values.
# NEVER commit .env to Git. Add it to .gitignore.

# ── Primary Supabase PostgreSQL Database (IPv4 Pooler for Render / Clouds) ───
# Direct db.[PROJECT_REF].supabase.co is IPv6-only. Use connection pooler for IPv4 clouds:
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# ── Institutional Admin Credentials ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$7i3dcYcR4JezUB.A8tsJb.GwL2VyCJKLJ0McXZ44KiIUzUWd7n2zW
ADMIN_NAME=System Administrator

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://attendtrax.vercel.app
