# ── Environment variables required by AttendTrax backend ──────────────────────
# Copy this file as .env and fill in your values.
# NEVER commit .env to Git. Add it to .gitignore.

# ── Google Sheets / Drive ─────────────────────────────────────────────────────
# Paste the contents of your service account JSON here, all on one line.
# Generate at: Google Cloud Console → IAM → Service Accounts → Keys → JSON
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "your-project-id", "private_key_id": "dummy_key_id", "private_key": "PASTE_PRIVATE_KEY_HERE", "client_email": "service-account@your-project.iam.gserviceaccount.com"}

# Google Spreadsheet IDs (from the URL: .../spreadsheets/d/<ID>/edit)
USERS_SHEET_ID=your_users_sheet_id_here
CLASSES_SHEET_ID=your_classes_sheet_id_here
STUDENTS_SHEET_ID=your_students_sheet_id_here
SUBJECTS_SHEET_ID=your_subjects_sheet_id_here
ATTENDANCE_LOG_SHEET_ID=your_attendance_log_sheet_id_here



# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://attendtrax.vercel.app
